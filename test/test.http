@host = http://localhost:4004/odata/v4/request

### Create equipment
# @name createEquipment
POST {{host}}/Equipment
Content-Type: application/json
Authorization: Basic carol:carol

{ "name": "MacBook Pro 14", "stock": 10 }

### List equipment
GET {{host}}/Equipment
Authorization: Basic carol:carol

### Create a request (status should be "New")
# @name createRequest
POST {{host}}/Requests
Content-Type: application/json
Authorization: Basic alice:alice

{
  "equipment_ID": "{{createEquipment.response.body.ID}}",
  "quantity": 1,
  "reason": "New hire laptop"
}

### List requests from alice
Get {{host}}/Requests
Authorization: Basic alice:alice

### employee submits own request
POST {{host}}/Requests({{createRequest.response.body.ID}})/RequestService.submit
Content-Type: application/json
Authorization: Basic alice:alice

{}

### employee approves own request (403 forbidden)
POST {{host}}/Requests({{createRequest.response.body.ID}})/RequestService.approve
Content-Type: application/json
Authorization: Basic alice:alice

{}

### employee tries to create equipment (403)
POST {{host}}/Equipment
Content-Type: application/json
Authorization: Basic alice:alice

{ "name": "Hacked item", "stock": 999 }

### manager sees alls requests
GET {{host}}/Requests
Authorization: Basic bob:bob

### manager tries to create a request (403)
POST {{host}}/Requests
Content-Type: application/json
Authorization: Basic bob:bob

{ "equipment_ID": "{{createEquipment.response.body.ID}}", "quantity": 1, "reason": "Nope" }

### manager approves (200, status "Approved")
POST {{host}}/Requests({{createRequest.response.body.ID}})/RequestService.approve
Content-Type: application/json
Authorization: Basic bob:bob

{}

### wrong user (401)
GET {{host}}/Requests
Authorization: Basic eve:eve
