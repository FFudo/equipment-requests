{
  "name": "equipment-requests",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test test/",
    "lint": "eslint .",
    "watch-requests": "cds watch --open requests/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "engines": {
    "node": ">=22.12"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "password": "alice",
            "roles": [
              "Employee"
            ]
          },
          "bob": {
            "password": "bob",
            "roles": [
              "Manager"
            ]
          },
          "carol": {
            "password": "carol",
            "roles": [
              "Admin"
            ]
          },
          "dave": false,
          "erin": false,
          "fred": false,
          "me": false,
          "yves": false,
          "*": false
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/requests"
  ]
}
